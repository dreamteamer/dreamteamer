{
	// Type-checks the tests without emitting: `npm run typecheck:test`. Kept out of tsconfig.json on
	// purpose — the tests are not the engine, so they are checked permissively (no strict, implicit any
	// allowed) and never gate the engine's own typecheck. test/types/consumer.ts is NOT here: it is the
	// public-API contract and is compiled strict by `npm run contract` against the generated declarations.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"strict": false,
		"noImplicitAny": false,
		"noImplicitThis": false,
		"useUnknownInCatchVariables": false,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noEmit": true
	},
	"include": ["test/**/*.ts"],
	"exclude": ["test/.tmp/**", "test/.perf/**", "test/types/**", "test/acceptance/out/**"]
}
