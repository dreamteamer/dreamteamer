{
	"name": "dreamteamer",
	"version": "0.47.0",
	"description": "A workspace compiler for coding agents — schema-validated records as plain files over git, compiled into every harness",
	"license": "Apache-2.0",
	"author": "Gilad Khen <giladkhen@gmail.com>",
	"homepage": "https://github.com/dreamteamer/dreamteamer#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dreamteamer/dreamteamer.git"
	},
	"bugs": {
		"url": "https://github.com/dreamteamer/dreamteamer/issues"
	},
	"keywords": [
		"agent",
		"coding-agent",
		"claude-code",
		"workspace",
		"compiler",
		"cli",
		"yaml",
		"markdown",
		"json-schema",
		"git"
	],
	"type": "module",
	"engines": {
		"node": ">=20",
		"npm": ">=7"
	},
	"main": "./dist/api.js",
	"types": "./dist/api.d.ts",
	"exports": {
		".": {
			"types": "./dist/api.d.ts",
			"default": "./dist/api.js"
		},
		"./records": {
			"types": "./dist/records-api.d.ts",
			"default": "./dist/records-api.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"dreamteamer": "bin/dreamteamer.js",
		"dt": "bin/dreamteamer.js"
	},
	"files": [
		"NOTICE",
		"bin",
		"dist",
		"collections",
		"skills",
		"agents",
		"commands",
		"command-bindings",
		"ui-views",
		"mixins"
	],
	"dependencies": {
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"fractional-indexing": "^4.0.0",
		"js-yaml": "^4.1.0",
		"yaml": "2.8.4"
	},
	"dreamteamer": {
		"title": "System"
	},
	"scripts": {
		"build": "tsx scripts/build.ts",
		"prepack": "tsx scripts/build.ts",
		"typecheck": "tsc -p tsconfig.json",
		"contract": "node scripts/contract.ts",
		"lint": "eslint --flag unstable_native_nodejs_ts_config .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "node scripts/test.ts",
		"test:unit": "node scripts/test.ts --unit",
		"test:watch": "node --watch scripts/test.ts --unit",
		"perf": "node test/perf/run.mjs",
		"metrics": "node scripts/metrics.ts",
		"metrics:check": "node scripts/metrics.ts --check",
		"layers": "node scripts/layers.ts",
		"verify": "node scripts/layers.ts && node scripts/metrics.ts --check && tsc -p tsconfig.json && npm run lint && npm run format:check && node scripts/test.ts",
		"verify:fast": "node scripts/layers.ts && node scripts/metrics.ts --check && tsc -p tsconfig.json && npm run lint && npm run format:check && node scripts/test.ts --changed"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.20.5",
		"eslint": "^10.14.0",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2"
	}
}
