{
	"name": "dreamteamer",
	"version": "0.33.0-integration.0",
	"description": "A workspace compiler for coding agents — schema-validated records as plain files over git, compiled into every harness",
	"license": "Apache-2.0",
	"author": "Gilad Khen <giladkhen@gmail.com>",
	"homepage": "https://github.com/dreamteamer/dreamteamer#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dreamteamer/dreamteamer.git"
	},
	"bugs": {
		"url": "https://github.com/dreamteamer/dreamteamer/issues"
	},
	"keywords": [
		"agent",
		"coding-agent",
		"claude-code",
		"workspace",
		"compiler",
		"cli",
		"yaml",
		"markdown",
		"json-schema",
		"git"
	],
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"main": "./src/api.js",
	"types": "./src/api.d.ts",
	"exports": {
		".": {
			"types": "./src/api.d.ts",
			"default": "./src/api.js"
		},
		"./records": {
			"types": "./src/records-api.d.ts",
			"default": "./src/records-api.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"dreamteamer": "bin/dreamteamer.js",
		"dt": "bin/dreamteamer.js"
	},
	"files": [
		"NOTICE",
		"bin",
		"src",
		"collections",
		"skills",
		"agents",
		"commands",
		"command-bindings",
		"ui-views",
		"collection-templates"
	],
	"dependencies": {
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"fractional-indexing": "^4.0.0",
		"js-yaml": "^4.1.0",
		"yaml": "2.8.4"
	},
	"dreamteamer": {
		"title": "System"
	},
	"scripts": {
		"test": "node scripts/test.mjs",
		"test:unit": "node scripts/test.mjs --unit",
		"test:watch": "node --watch scripts/test.mjs --unit",
		"perf": "node test/perf/run.mjs",
		"metrics": "node scripts/metrics.mjs",
		"metrics:check": "node scripts/metrics.mjs --check",
		"layers": "node scripts/layers.mjs",
		"verify": "node scripts/layers.mjs && node scripts/metrics.mjs --check && node scripts/test.mjs",
		"verify:fast": "node scripts/layers.mjs && node scripts/metrics.mjs --check && node scripts/test.mjs --changed"
	}
}
